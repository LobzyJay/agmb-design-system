{
  "name": "agmb-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lh": "lighthouse http://localhost:3000 --output=json --output-path=./perf/lighthouse.json --quiet --chrome-flags=\"--headless\"",
    "lh:desktop": "lighthouse http://localhost:3000 --preset=desktop --output=json --output=html --output-path=./perf/lighthouse-desktop --quiet --chrome-flags=\"--headless\"",
    "lh:3g": "lighthouse http://localhost:3000 --form-factor=mobile --throttling-method=devtools --throttling.cpuSlowdownMultiplier=4 --throttling.requestLatencyMs=150 --throttling.downloadThroughputKbps=1638.4 --throttling.uploadThroughputKbps=750 --output=json --output=html --output-path=./perf/lighthouse-3g --quiet --chrome-flags=\"--headless\""
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-storybook": "^10.3.6",
    "playwright": "^1.59.1",
    "storybook": "^10.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
