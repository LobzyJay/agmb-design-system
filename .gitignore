# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

# claude code agent memory + local state
# (also stops Tailwind v4 from scanning .md memory files for class names)
/.claude/

# audit artifacts — regeneratable from /lh / /lh:desktop / /lh:3g scripts
# and the a11y audit pipeline. Large JSON dumps don't belong in version control.
/a11y/
/perf/
